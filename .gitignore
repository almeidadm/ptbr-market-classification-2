data/raw/*
!data/raw/.gitkeep
!data/raw/DATASET_HASH.txt

# Dataset processado — reconstruído via scripts/preprocessar.py (vide docs/decisoes/009)
data/processado/*
!data/processado/.gitkeep

# Artefatos de experimentos — reconstruídos via scripts/experimentar.py (vide docs/decisoes/009)
artifacts/experimentos/*
!artifacts/experimentos/.gitkeep

# Artefatos de drift — reconstruídos via scripts/drift/*.py (vide docs/decisoes/011)
artifacts/drift/*
!artifacts/drift/.gitkeep

